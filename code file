// Ye structure ek Customer ko represent karta hai.
// Customer ke paas ek ID aur ek name hoga.
// Ye info "customers.txt" file me save ki jaati hai.
struct Customer {
    string id;
    string name;
};

// Ye structure ek Product ko represent karta hai.
// Har product ka ek ID, ek name aur ek price hota hai.
// Ye info "products.txt" file me save hoti hai.
struct Product {
    string id;
    string name;
    float price;
};

// Ye structure ek "Item" ko represent karta hai jo Invoice ke andar hota hai.
// Har item ek Product hota hai + uski Quantity.
// Matlab invoice me ek hi product multiple quantity me ho sakta hai.
struct Item {
    Product product;
    int quantity;
};



// Ye function current date aur time ko ek readable string me return karta hai.
// Example: 2025-08-23 15:45
// Iska use invoices aur invoice records me date/time show karne ke liye hota hai.
string getDateTime() {
    time_t now = time(0);
    tm *ltm = localtime(&now);
    stringstream ss;
    ss << 1900 + ltm->tm_year << "-"
       << setw(2) << setfill('0') << 1 + ltm->tm_mon << "-"
       << setw(2) << setfill('0') << ltm->tm_mday << " "
       << setw(2) << setfill('0') << ltm->tm_hour << ":"
       << setw(2) << setfill('0') << ltm->tm_min;
    return ss.str();
}

// Ye function ek naya unique Invoice ID banata hai jo 0001, 0002 ... ke form me hota hai.
// Function "invoices.txt" file padhta hai aur last invoice ka ID nikalta hai,
// phir usko +1 karke naya invoice banata hai.
// Example: agar last invoice 0005 tha, to ye function "0006" return karega.
string generateInvoiceID() {
    ifstream in("invoices.txt");
    string line, lastID = "0000";
    if (in) {
        while (getline(in, line)) {
            if (line.size() >= 4) lastID = line.substr(0, 4); 
        }
        in.close();
    }
    int num = atoi(lastID.c_str()); // string ko integer me convert karna 
    if (num < 0) num = 0;
    num += 1;

    stringstream ss;
    ss << setw(4) << setfill('0') << num;
    return ss.str();
}



// Ye function ek naya Customer add karta hai.
// User se Customer ID aur name input liya jata hai aur phir "customers.txt" me save hota hai.
void addCustomer() {
    ofstream out("customers.txt", ios::app);
    if (!out) {
        cout << "Unable to open customers.txt\n";
        return;
    }
    Customer c;
    cout << "Enter customer ID: ";
    cin >> c.id;
    cin.ignore();
    cout << "Enter customer name: ";
    getline(cin, c.name);
    out << c.id << "," << c.name << endl;
    out.close();
