}

// Ye function ek naya Product add karta hai.
// User se Product ID, name aur price input liya jata hai aur phir "products.txt" me save hota hai.
void addProduct() {
    ofstream out("products.txt", ios::app);
    if (!out) {
        cout << "Unable to open products.txt\n";
